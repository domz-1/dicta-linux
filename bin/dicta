"""

import sys
import os
import time
import threading
import subprocess
import urllib.request
import urllib.parse
import json
import signal
import io
import wave
import struct
import math
import re

os.environ["DISPLAY"] = os.environ.get("DISPLAY", ":0")

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib, Pango

PID_FILE = "/tmp/dicta_gui.pid"
SOUND_START = "/usr/share/sounds/freedesktop/stereo/message.oga"
SOUND_DONE = "/usr/share/sounds/freedesktop/stereo/complete.oga"

WHISPER_CLI = "/home/adham/whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL = "/home/adham/whisper.cpp/models/ggml-base.bin"

def play_sound(sound_path):
    if os.path.exists(sound_path):
        try: subprocess.Popen(["paplay", sound_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception: pass

def pcm_to_flac(pcm_data, sample_rate=16000):
    wav_io = io.BytesIO()
    with wave.open(wav_io, "wb") as wf:
        wf.setnchannels(1)
        wf.setsampwidth(2)
        wf.setframerate(sample_rate)
        wf.writeframes(pcm_data)
    wav_bytes = wav_io.getvalue()

    p = subprocess.Popen(
        ["ffmpeg", "-loglevel", "quiet", "-f", "wav", "-i", "pipe:0", "-f", "flac", "pipe:1"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL
    )
    flac_bytes, _ = p.communicate(input=wav_bytes)
    return flac_bytes

def transcribe_google(flac_bytes, lang="ar-EG"):
    url = f"https://www.google.com/speech-api/v2/recognize?output=json&lang={lang}&client=chromium&key="
    req = urllib.request.Request(
        url,
        data=flac_bytes,
        headers={"Content-Type": "audio/x-flac; rate=16000", "User-Agent": "Mozilla/5.0"}
    )
    try:
        with urllib.request.urlopen(req, timeout=5) as res:
            raw = res.read().decode("utf-8")
            lines = [l.strip() for l in raw.split("\n") if l.strip()]
            for line in lines:
                try:
                    data = json.loads(line)
                    results = data.get("result", [])
                    if results and len(results) > 0:
                        hypotheses = results[0].get("alternative", [])
                        if hypotheses:
                            return hypotheses[0].get("transcript", "").strip()
                except Exception:
                    pass
    except Exception:
        pass
    return ""

def transcribe_whisper(pcm_data):
    if os.path.exists(WHISPER_CLI) and os.path.exists(WHISPER_MODEL):
        import tempfile
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
            wav_path = tf.name
            with wave.open(wav_path, "wb") as wf:
                wf.setnchannels(1)
                wf.setsampwidth(2)
                wf.setframerate(16000)
                wf.writeframes(pcm_data)
        try:
            cmd = [WHISPER_CLI, "-m", WHISPER_MODEL, "-f", wav_path, "-l", "auto", "--no-timestamps", "-nt"]
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=7)
            lines = res.stdout.strip().splitlines()
            text = " ".join(line.strip() for line in lines if line.strip() and not line.startswith("[") and not line.startswith("whisper_"))
            text = re.sub(r'\[\d+:\d+:\d+\.\d+ --> \d+:\d+:\d+\.\d+\]', '', text).strip()
            return text
        except Exception:
            pass
        finally:
            try: os.remove(wav_path)
            except Exception: pass
    return ""

def transcribe_chunk(pcm_data, lang="ar-EG"):
    flac_bytes = pcm_to_flac(pcm_data)
    text = ""
    if flac_bytes and len(flac_bytes) > 800:
        text = transcribe_google(flac_bytes, lang=lang)
        if not text and lang != "en-US":
            text = transcribe_google(flac_bytes, lang="en-US")
    if not text:
        text = transcribe_whisper(pcm_data)
    return text.strip()

def paste_text(text):
    try:
        p = subprocess.Popen(["xclip", "-selection", "clipboard"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
        p.communicate(input=text.encode("utf-8"))
    except Exception: pass
    try:
        p = subprocess.Popen(["xclip", "-selection", "primary"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
        p.communicate(input=text.encode("utf-8"))
    except Exception: pass

    subprocess.run(["copyq", "copy", text], stderr=subprocess.DEVNULL)
    time.sleep(0.08)
    subprocess.run(["copyq", "paste"], stderr=subprocess.DEVNULL)

class LiveSpeechHUD(Gtk.Window):
    def __init__(self, lang="ar-EG"):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.lang = lang
        self.running = True
        self.transcribed_words = []
        self.current_live_text = "Listening... Speak now in Arabic or English"

        self.set_title("Dicta Live Voice Typing")
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_app_paintable(True)
        self.set_default_size(560, 90)
        self.set_position(Gtk.WindowPosition.CENTER)

        # Apply Modern Dark CSS Style
        css = b"""
        window {
            background-color: rgba(24, 24, 27, 0.94);
            border-radius: 20px;
            border: 2px solid rgba(59, 130, 246, 0.8);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
        }
        label#status {
            color: #60a5fa;
            font-size: 13px;
            font-weight: bold;
        }
        label#live_text {
            color: #f8fafc;
            font-size: 16px;
            font-weight: 500;
        }
        button#done_btn {
            background: linear-gradient(135deg, #2563eb, #1d4ed8);
            color: white;
            border-radius: 12px;
            font-weight: bold;
            padding: 6px 14px;
            border: none;
        }
        button#done_btn:hover {
            background: #3b82f6;
        }
        button#cancel_btn {
            background: rgba(255, 255, 255, 0.1);
            color: #cbd5e1;
            border-radius: 12px;
            padding: 6px 12px;
            border: none;
        }
        button#cancel_btn:hover {
            background: rgba(239, 68, 68, 0.4);
            color: white;
        }
        """
        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        # Layout Container
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        main_box.set_margin_top(12)
        main_box.set_margin_bottom(12)
        main_box.set_margin_start(18)
        main_box.set_margin_end(18)

        # Header bar with Status & Controls
        header_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.mic_icon = Gtk.Label(label="🎙️ 🔴")
        self.status_lbl = Gtk.Label(label="Live Voice Typing (Arabic + English)")
        self.status_lbl.set_name("status")

        cancel_btn = Gtk.Button(label="✕ Cancel")
        cancel_btn.set_name("cancel_btn")
        cancel_btn.connect("clicked", self.on_cancel)

        done_btn = Gtk.Button(label="✓ Insert (Enter)")
        done_btn.set_name("done_btn")
        done_btn.connect("clicked", self.on_done)

        header_box.pack_start(self.mic_icon, False, False, 0)
        header_box.pack_start(self.status_lbl, False, False, 0)
        header_box.pack_end(done_btn, False, False, 0)
        header_box.pack_end(cancel_btn, False, False, 0)

        # Live Text Display
        self.text_label = Gtk.Label(label=self.current_live_text)
        self.text_label.set_name("live_text")
        self.text_label.set_line_wrap(True)
        self.text_label.set_max_width_chars(50)
        self.text_label.set_alignment(0.0, 0.5)

        main_box.pack_start(header_box, False, False, 0)
        main_box.pack_start(self.text_label, True, True, 4)

        self.add(main_box)
        self.connect("key-press-event", self.on_key_press)
        self.show_all()

        play_sound(SOUND_START)

        # Start audio capture thread
        self.thread = threading.Thread(target=self.audio_loop, daemon=True)
        self.thread.start()

    def on_key_press(self, widget, event):
        if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter, Gdk.KEY_space):
            self.on_done()
            return True
        elif event.keyval == Gdk.KEY_Escape:
            self.on_cancel()
            return True
        return False

    def update_ui_text(self, text):
        self.text_label.set_text(text)

    def audio_loop(self):
        proc = subprocess.Popen(
            ["parec", "--rate=16000", "--channels=1", "--format=s16le"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL
        )

        CHUNK_MS = 50
        CHUNK_BYTES = int(16000 * 2 * (CHUNK_MS / 1000)) # 1600 bytes
        SILENCE_LIMIT = int(800 / CHUNK_MS) # 0.8s silence triggers phrase commit

        # Calibrate
        ambient = []
        for _ in range(4):
            raw = proc.stdout.read(CHUNK_BYTES)
            if not raw: break
            count = len(raw) // 2
            shorts = struct.unpack(f"{count}h", raw)
            ambient.append(int(math.sqrt(sum(s * s for s in shorts) / count)))
        
        base_noise = max(30, sum(ambient) // len(ambient) if ambient else 70)
        THRESHOLD = max(110, int(base_noise * 1.35))

        speech_buffer = bytearray()
        is_speaking = False
        silence_count = 0

        while self.running:
            raw = proc.stdout.read(CHUNK_BYTES)
            if not raw: break

            count = len(raw) // 2
            shorts = struct.unpack(f"{count}h", raw)
            rms = int(math.sqrt(sum(s * s for s in shorts) / count))

            if rms >= THRESHOLD:
                if not is_speaking:
                    is_speaking = True
                    silence_count = 0
                    GLib.idle_add(self.mic_icon.set_text, "🎙️ 🟢")
                speech_buffer.extend(raw)
                silence_count = 0
            else:
                if is_speaking:
                    speech_buffer.extend(raw)
                    silence_count += 1
                    if silence_count >= SILENCE_LIMIT:
                        # Process spoken phrase
                        GLib.idle_add(self.mic_icon.set_text, "🎙️ ⏳")
                        if len(speech_buffer) >= CHUNK_BYTES * 5:
                            text = transcribe_chunk(bytes(speech_buffer), lang=self.lang)
                            if text:
                                self.transcribed_words.append(text)
                                full_sentence = " ".join(self.transcribed_words)
                                GLib.idle_add(self.update_ui_text, full_sentence)
                        
                        speech_buffer = bytearray()
                        is_speaking = False
                        silence_count = 0
                        GLib.idle_add(self.mic_icon.set_text, "🎙️ 🔴")

        try: proc.terminate()
        except Exception: pass

    def on_done(self, *args):
        self.running = False
        full_text = " ".join(self.transcribed_words).strip()
        if not full_text and self.text_label.get_text() != self.current_live_text:
            full_text = self.text_label.get_text().strip()

        self.destroy()
        if full_text:
            paste_text(full_text + " ")
            play_sound(SOUND_DONE)
            subprocess.run(["notify-send", "-u", "low", "-i", "emblem-default", "✨ Dicta Live", full_text])
        Gtk.main_quit()

    def on_cancel(self, *args):
        self.running = False
        self.destroy()
        Gtk.main_quit()

def main():
    if os.path.exists(PID_FILE):
        # Already open -> Toggle close/done!
        try:
            with open(PID_FILE, "r") as f: pid = int(f.read().strip())
            os.kill(pid, signal.SIGTERM)
        except Exception: pass
        try: os.remove(PID_FILE)
        except Exception: pass
        return

    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    hud = LiveSpeechHUD(lang="ar-EG")
    
    def cleanup(*args):
        if os.path.exists(PID_FILE):
            try: os.remove(PID_FILE)
            except Exception: pass
        Gtk.main_quit()

    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    try:
        Gtk.main()
    finally:
        if os.path.exists(PID_FILE):
            try: os.remove(PID_FILE)
            except Exception: pass

if __name__ == "__main__":
    main()
