#!/usr/bin/env python3
"""
Dicta Linux - Smart Bilingual Speech-to-Text & Voice Typing for Linux
Author: Adham (@domz-1)
License: MIT
"""

import sys
import os
import time
import argparse
import subprocess
import urllib.request
import urllib.parse
import json
import signal
import tempfile
import re

PID_FILE = "/tmp/dicta_recording.pid"
AUDIO_FILE = "/tmp/dicta_audio.wav"
FLAC_FILE = "/tmp/dicta_audio.flac"

os.environ["DISPLAY"] = os.environ.get("DISPLAY", ":0")

WHISPER_CLI = "/home/adham/whisper.cpp/build/bin/whisper-cli"
WHISPER_MODEL = "/home/adham/whisper.cpp/models/ggml-base.bin"

def is_recording():
    if os.path.exists(PID_FILE):
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            return pid
        except Exception:
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
    return None

def start_recording():
    # Clean previous files
    for p in [AUDIO_FILE, FLAC_FILE]:
        if os.path.exists(p):
            try: os.remove(p)
            except Exception: pass

    # Use ffmpeg with pulse input (super reliable) or arecord
    cmd = [
        "ffmpeg", "-y", "-loglevel", "quiet",
        "-f", "pulse", "-i", "default",
        "-ar", "16000", "-ac", "1",
        AUDIO_FILE
    ]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        with open(PID_FILE, "w") as f:
            f.write(str(proc.pid))
        
        subprocess.run([
            "notify-send", "-u", "normal",
            "-i", "audio-input-microphone",
            "🎙️ Dicta - Recording Started",
            "Speak now in Arabic or English...\n(Press Alt+D again to finish)"
        ])
        return True
    except Exception as e:
        subprocess.run(["notify-send", "-u", "critical", "Dicta Error", f"Failed to start microphone: {e}"])
        return False

def stop_recording(pid):
    try:
        os.kill(pid, signal.SIGTERM)
        time.sleep(0.3)
    except Exception:
        pass
    try:
        if os.path.exists(PID_FILE):
            os.remove(PID_FILE)
    except Exception:
        pass

def transcribe_google(flac_bytes, lang="ar-EG"):
    url = f"https://www.google.com/speech-api/v2/recognize?output=json&lang={lang}&client=chromium&key="
    req = urllib.request.Request(
        url,
        data=flac_bytes,
        headers={"Content-Type": "audio/x-flac; rate=16000", "User-Agent": "Mozilla/5.0"}
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as res:
            raw = res.read().decode("utf-8")
            lines = [l.strip() for l in raw.split("\n") if l.strip()]
            for line in lines:
                try:
                    data = json.loads(line)
                    results = data.get("result", [])
                    if results and len(results) > 0:
                        hypotheses = results[0].get("alternative", [])
                        if hypotheses:
                            return hypotheses[0].get("transcript", "").strip()
                except Exception:
                    pass
    except Exception:
        pass
    return ""

def transcribe_whisper(wav_file, lang="auto"):
    if os.path.exists(WHISPER_CLI) and os.path.exists(WHISPER_MODEL):
        cmd = [
            WHISPER_CLI,
            "-m", WHISPER_MODEL,
            "-f", wav_file,
            "-l", lang,
            "--no-timestamps",
            "-nt"
        ]
        try:
            res = subprocess.run(cmd, capture_output=True, text=True, timeout=12)
            lines = res.stdout.strip().splitlines()
            # Clean whisper output
            text = " ".join(line.strip() for line in lines if line.strip() and not line.startswith("[") and not line.startswith("whisper_"))
            # Remove repeated bracket timestamps if any
            text = re.sub(r'\[\d+:\d+:\d+\.\d+ --> \d+:\d+:\d+\.\d+\]', '', text).strip()
            return text
        except Exception:
            pass
    return ""

def transcribe_audio(wav_file, preferred_lang="ar-EG"):
    # 1. Convert to 16kHz mono FLAC for cloud engine
    subprocess.run(["ffmpeg", "-y", "-loglevel", "quiet", "-i", wav_file, "-ar", "16000", "-ac", "1", FLAC_FILE])
    
    flac_bytes = None
    if os.path.exists(FLAC_FILE):
        with open(FLAC_FILE, "rb") as f:
            flac_bytes = f.read()

    text = ""
    # 2. Try Google Cloud engine (first preferred lang, then en fallback)
    if flac_bytes and len(flac_bytes) > 2000:
        text = transcribe_google(flac_bytes, lang=preferred_lang)
        if not text and preferred_lang != "en-US":
            text = transcribe_google(flac_bytes, lang="en-US")

    # 3. Fallback to local Whisper engine
    if not text and os.path.exists(wav_file):
        text = transcribe_whisper(wav_file)

    return text.strip()

def paste_text(text):
    # Copy to clipboard via copyq and xclip
    try:
        p = subprocess.Popen(["xclip", "-selection", "clipboard"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass
    try:
        p = subprocess.Popen(["xclip", "-selection", "primary"], stdin=subprocess.PIPE, stderr=subprocess.DEVNULL)
        p.communicate(input=text.encode("utf-8"))
    except Exception:
        pass

    subprocess.run(["copyq", "copy", text], stderr=subprocess.DEVNULL)
    
    # Auto-paste in active window
    time.sleep(0.15)
    subprocess.run(["copyq", "paste"], stderr=subprocess.DEVNULL)

def toggle_dictate(lang="ar-EG"):
    pid = is_recording()
    if pid:
        # Currently recording -> Stop & Transcribe!
        subprocess.run(["notify-send", "-u", "normal", "-i", "audio-volume-high", "Dicta", "⏳ Transcribing speech..."])
        stop_recording(pid)
        
        if not os.path.exists(AUDIO_FILE) or os.path.getsize(AUDIO_FILE) < 4000:
            subprocess.run(["notify-send", "-u", "low", "Dicta", "⚠️ Recording was too short."])
            return

        text = transcribe_audio(AUDIO_FILE, preferred_lang=lang)
        if text:
            paste_text(text)
            subprocess.run(["notify-send", "-u", "normal", "-i", "emblem-default", "✨ Dicta Transcribed & Pasted!", text])
            subprocess.run(["copyq", "popup", "✨ Dicta Voice Typing", f"{text}\n(Pasted automatically)"])
        else:
            subprocess.run(["notify-send", "-u", "low", "Dicta", "⚠️ Could not recognize speech. Please try again."])
    else:
        # Start recording
        start_recording()

def main():
    parser = argparse.ArgumentParser(description="Dicta Linux - Smart Bilingual Speech-to-Text & Voice Typing")
    parser.add_argument("-f", "--file", help="Transcribe audio file")
    parser.add_argument("-l", "--lang", default="ar-EG", help="Preferred language (ar-EG, en-US, auto)")
    parser.add_argument("-o", "--save", help="Save transcription to text file")
    parser.add_argument("--stop", action="store_true", help="Stop recording")
    parser.add_argument("--status", action="store_true", help="Check recording status")

    args = parser.parse_args()

    if args.status:
        if is_recording(): print("Recording in progress.")
        else: print("Idle.")
        return

    if args.stop:
        pid = is_recording()
        if pid:
            stop_recording(pid)
            print("Stopped recording.")
        return

    if args.file:
        audio_path = os.path.abspath(args.file)
        print(f"Transcribing file: {audio_path}...")
        text = transcribe_audio(audio_path, preferred_lang=args.lang)
        print("Transcript:\n", text)
        if args.save:
            with open(args.save, "w", encoding="utf-8") as f:
                f.write(text)
            print(f"Saved to: {args.save}")
        return

    # Default action: Toggle Voice Typing
    toggle_dictate(lang=args.lang)

if __name__ == "__main__":
    main()
